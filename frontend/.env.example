# Jowis Studio ERP Frontend Environment Configuration
# For local development with Vite dev server proxying /api to port 5000, leave unset or '/api'
VITE_API_BASE_URL=/api

# For separate production deployment (e.g. Vercel/Netlify pointing to backend API server):
# VITE_API_BASE_URL=https://api.erp.jowis.com/api
