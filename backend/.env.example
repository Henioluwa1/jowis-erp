PORT=5000
NODE_ENV=development

# MySQL Database Configuration (XAMPP default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jowis_studio_erp
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Operational Timezone & Attendance Rules
APP_TIMEZONE=Africa/Lagos
ATTENDANCE_CUTOFF_TIME=09:00:00

# CORS
CORS_ORIGIN=http://localhost:5173
